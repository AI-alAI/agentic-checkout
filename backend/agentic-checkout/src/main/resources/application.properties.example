# Server
server.port=8080

# Database
spring.datasource.url=jdbc:mysql://localhost:3306/paypilot_db?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC
spring.datasource.username=root
spring.datasource.password=VOTRE_MOT_DE_PASSE_MYSQL
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

# JPA
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true

# PayPal Sandbox (Obtenir sur https://developer.paypal.com)
paypal.client-id=VOTRE_CLIENT_ID
paypal.client-secret=VOTRE_SECRET
paypal.base-url=https://api-m.sandbox.paypal.com